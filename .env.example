# Database
POSTGRES_DB=archivaries
POSTGRES_USER=aries_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://aries_user:change_me_in_production@localhost:5432/archivaries

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace_with_strong_secret_64_chars_min
JWT_REFRESH_SECRET=replace_with_different_strong_secret_64_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=3000

# Seed super-admin
SEED_ADMIN_EMAIL=admin@ariesferrus.local
SEED_ADMIN_PASSWORD=change_me_in_production

# Frontend (build-time)
VITE_API_URL=http://localhost:3000/api
